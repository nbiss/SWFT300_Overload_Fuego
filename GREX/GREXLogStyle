.login-container {
  width: 300px;
  margin: 100px auto;
  padding: 20px;
  background-color: #4a2d7e;
  color: #f6e9a6;
  border-radius: 10px;
  text-align: center;
}

.login-container input, .login-container select {
  width: 100%;
  padding: 10px;
  margin: 10px 0;
}

.login-container button {
  background-color: #f6e9a6;
  color: #3f2b63;
  border: none;
  padding: 10px;
  cursor: pointer;
  font-weight: bold;
}
