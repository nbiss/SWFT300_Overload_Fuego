<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>GREX Login</title>
  <link rel="stylesheet" href="GREXLogStyle.css">
</head>
<body>
  <div class="login-container">
    <h1>GREX Login</h1>
    <form id="loginForm">
      <label>Email:</label>
      <input type="email" id="email" required>
      
      <label>Password:</label>
      <input type="password" id="password" required>
      
      <label>Role:</label>
      <select id="role" required>
        <option value="athlete">Athlete</option>
        <option value="coach">Coach</option>
      </select>
      
      <button type="submit">Login</button>
    </form>
    <p id="message"></p>
  </div>
  <script src="GREXLogScript.js"></script>
</body>
</html>
